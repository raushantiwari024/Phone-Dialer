<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Parented to the dark framework theme, not Material.Light. The previous Light parent gave the
      window a white background, so every cold start and every full-screen-intent call launch flashed
      white before Compose drew its first frame — very visible when a call takes over the lock screen.
    -->
    <style name="Theme.Phone" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <!-- Theme for the dedicated call activity. -->
    <style name="Theme.Phone.InCall" parent="Theme.Phone">
        <item name="android:windowBackground">@color/incall_window_background</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@style/Animation.Phone.InCall</item>
    </style>

    <!--
      A call taking over the screen should fade in, not slide in from the side like an ordinary
      navigation push.
    -->
    <style name="Animation.Phone.InCall" parent="android:Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

</resources>
